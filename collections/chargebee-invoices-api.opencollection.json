{
  "opencollection": "1.0.0",
  "info": {
    "name": "Chargebee API v2 Customers Invoices API",
    "version": "2"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Invoices",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List invoices",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{site}.chargebee.com/api/v2/invoices"
          },
          "docs": "List invoices"
        },
        {
          "info": {
            "name": "Retrieve an invoice",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{site}.chargebee.com/api/v2/invoices/:invoice_id",
            "params": [
              {
                "name": "invoice_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve an invoice"
        }
      ]
    }
  ],
  "bundled": true
}